# Copie este arquivo para .env e substitua todos os valores de exemplo.
# Nunca versione o .env real.

# PostgreSQL
POSTGRES_DB=clinic_management
POSTGRES_USER=clinic_app
POSTGRES_PASSWORD=change-this-local-password

# API
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
LOGIN_RATE_LIMIT=5/minute

# O navegador acessa a API pelo host; por isso localhost é usado no ambiente local.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
VITE_API_URL=http://localhost:8000/api/v1

# Portas publicadas no host
API_PORT=8000
FRONTEND_PORT=8080
