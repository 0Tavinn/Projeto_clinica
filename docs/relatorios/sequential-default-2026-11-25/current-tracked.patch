+      timeout: 3s
+      retries: 40
+  api:
+    build:
+      context: ./backend
+      args:
+        SOURCE_COMMIT: ${SOURCE_COMMIT:-unknown}
+    restart: unless-stopped
+    environment:
+      ENVIRONMENT: development
+      DEBUG: "false"
+      APPOINTMENT_CONFLICT_ENGINE: ${APPOINTMENT_CONFLICT_ENGINE:-sequential}
+      APPOINTMENT_CONFLICT_BATCH_SIZE: ${APPOINTMENT_CONFLICT_BATCH_SIZE:-4096}
