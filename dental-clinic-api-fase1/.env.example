# Copie para .env e ajuste os valores. NUNCA commite o .env real.

# development | test | production
ENVIRONMENT=development
DEBUG=true

# MySQL (formato: mysql+pymysql://user:password@host:3306/dbname)
# A arquitetura evita features específicas do MySQL para permitir migração
# futura para PostgreSQL (postgresql+psycopg://user:password@host:5432/dbname)
DATABASE_URL=mysql+pymysql://dental_user:dental_pass@localhost:3306/dental_clinic

# OBRIGATÓRIO em produção: gere um valor forte e único, ex:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=INSECURE-DEV-ONLY-CHANGE-ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Lista separada por vírgula de origens permitidas para CORS.
# Vazio = nenhuma origem cross-site liberada.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

LOGIN_RATE_LIMIT=5/minute
