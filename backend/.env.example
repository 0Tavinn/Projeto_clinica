# Copie para .env e ajuste os valores. NUNCA commite o .env real.

# development | test | production
ENVIRONMENT=development
DEBUG=true

# PostgreSQL local: defina uma URL própria com o driver postgresql+psycopg.
# Consulte ../docs/database-setup.md antes de preparar ou atualizar o banco.
DATABASE_URL=postgresql+psycopg://clinic_app:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/clinic_management

# OBRIGATÓRIO em produção: gere um valor forte e único, ex:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=INSECURE-DEV-ONLY-CHANGE-ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Lista separada por vírgula de origens permitidas para CORS.
# Vazio = nenhuma origem cross-site liberada.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

LOGIN_RATE_LIMIT=5/minute
