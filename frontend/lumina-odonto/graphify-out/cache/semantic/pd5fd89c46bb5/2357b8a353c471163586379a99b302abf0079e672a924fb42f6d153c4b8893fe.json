{"nodes": [{"id": "graphify_out_memory_docs_api_integration_doc", "label": "docs/api-integration.md \u2014 Contrato atual da API (Sprint 4)", "file_type": "document", "source_file": "graphify-out/memory/docs/api-integration.md", "source_location": "L1-L405", "source_url": null, "captured_at": "2026-09-23", "author": null, "contributor": null, "rationale": "Descreve S\u00d3 o que est\u00e1 implementado no backend; n\u00e3o antecipa endpoints futuros. Fonte de verdade para o front."}, {"id": "graphify_out_memory_docs_api_integration_base_url", "label": "URL base centralizada http://localhost:8000/api/v1", "file_type": "document", "source_file": "graphify-out/memory/docs/api-integration.md", "source_location": "L9-L27", "source_url": null, "captured_at": "2026-09-23", "author": null, "contributor": null, "rationale": "N\u00e3o espalhar a URL em componentes: centralizar em config por ambiente. /health \u00e9 p\u00fablico e n\u00e3o checa o PostgreSQL."}, {"id": "graphify_out_memory_docs_api_integration_health", "label": "GET /health", "file_type": "document", "source_file": "graphify-out/memory/docs/api-integration.md", "source_location": "L99-L116", "source_url": null, "captured_at": "2026-09-23", "author": null, "contributor": null, "rationale": "Retorna {status, app, environment}; s\u00f3 disponibilidade do processo."}, {"id": "graphify_out_memory_docs_api_integration_login", "label": "POST /api/v1/auth/login (OAuth2 form)", "file_type": "document", "source_file": "graphify-out/memory/docs/api-integration.md", "source_location": "L44-L77", "source_url": null, "captured_at": "2026-09-23", "author": null, "contributor": null, "rationale": "Body x-www-form-urlencoded via URLSearchParams({username: email, password}). Respostas 200/401/422/429 (rate limit)/500."}, {"id": "graphify_out_memory_docs_api_integration_refresh", "label": "POST /api/v1/auth/refresh", "file_type": "document", "source_file": "graphify-out/memory/docs/api-integration.md", "source_location": "L38-L42,L123-L132", "source_url": null, "captured_at": "2026-09-23", "author": null, "contributor": null, "rationale": "JSON {refresh_token}; devolve NOVO PAR de tokens (substituir ambos). 401 se refresh inv\u00e1lido/expirado."}, {"id": "graphify_out_memory_docs_api_integration_me", "label": "GET /api/v1/auth/me", "file_type": "document", "source_file": "graphify-out/memory/docs/api-integration.md", "source_location": "L79-L80,L134-L147", "source_url": null, "captured_at": "2026-09-23", "author": null, "contributor": null, "rationale": "Retorna {id, clinic_id, full_name, email, cpf, phone, role, is_active}; o role orienta navega\u00e7\u00e3o e controles da UI."}, {"id": "graphify_out_memory_docs_api_integration_no_logout", "label": "Sem endpoint de logout", "file_type": "concept", "source_file": "graphify-out/memory/docs/api-integration.md", "source_location": "L40-L42", "source_url": null, "captured_at": "2026-09-23", "author": null, "contributor": null, "rationale": "Logout \u00e9 s\u00f3 no front: descartar sess\u00e3o armazenada e redirecionar ao login."}, {"id": "graphify_out_memory_docs_api_integration_permissions", "label": "Matriz de permiss\u00f5es vigente (ADMIN / RECEP / DENTIST)", "file_type": "concept", "source_file": "graphify-out/memory/docs/api-integration.md", "source_location": "L82-L95", "source_url": null, "captured_at": "2026-09-23", "author": null, "contributor": null, "rationale": "Todos: login/refresh/me e listar/consultar pacientes. S\u00f3 ADMIN cadastra usu\u00e1rio. ADMIN e RECEP criam/editam/inativam paciente; DENTIST N\u00c3O (hoje). API \u00e9 a autoridade final (403)."}, {"id": "graphify_out_memory_docs_api_integration_users_post", "label": "POST /api/v1/users", "file_type": "document", "source_file": "graphify-out/memory/docs/api-integration.md", "source_location": "L149-L195", "source_url": null, "captured_at": "2026-09-23", "author": null, "contributor": null, "rationale": "S\u00f3 ADMINISTRATOR. full_name 1-150, email v\u00e1lido, password 8-128, cpf 11 d\u00edgitos, role enum, phone opcional \u226420. Resposta 201 sem senha/hash; clinic_id vem do admin."}, {"id": "graphify_out_memory_docs_api_integration_no_users_list", "label": "GET /api/v1/users N\u00c3O existe", "file_type": "concept", "source_file": "graphify-out/memory/docs/api-integration.md", "source_location": "L197-L199", "source_url": null, "captured_at": "2026-09-23", "author": null, "contributor": null, "rationale": "Tela de equipe n\u00e3o consegue listar usu\u00e1rios ainda; n\u00e3o supor a rota."}, {"id": "graphify_out_memory_docs_api_integration_patients", "label": "CRUD /api/v1/patients", "file_type": "document", "source_file": "graphify-out/memory/docs/api-integration.md", "source_location": "L201-L262", "source_url": null, "captured_at": "2026-09-23", "author": null, "contributor": null, "rationale": "POST (admin/recep) 201; GET lista s\u00f3 ativos; GET/{id}; PATCH s\u00f3 campos alterados (null \u00e9 ignorado \u2014 n\u00e3o d\u00e1 para limpar campo); DELETE = inativa\u00e7\u00e3o 204 sem corpo."}, {"id": "graphify_out_memory_docs_api_integration_patient_fields", "label": "Campos de paciente (valida\u00e7\u00e3o)", "file_type": "concept", "source_file": "graphify-out/memory/docs/api-integration.md", "source_location": "L211-L221", "source_url": null, "captured_at": "2026-09-23", "author": null, "contributor": null, "rationale": "full_name 1-150, cpf 11 d\u00edgitos, medical_record_number 1-30 (salvo em MAI\u00daSCULAS), birth_date YYYY-MM-DD, phone \u226420, email opcional v\u00e1lido, address opcional."}, {"id": "graphify_out_memory_docs_api_integration_clinic_isolation", "label": "Isolamento por cl\u00ednica + normaliza\u00e7\u00e3o", "file_type": "concept", "source_file": "graphify-out/memory/docs/api-integration.md", "source_location": "L264-L280", "source_url": null, "captured_at": "2026-09-23", "author": null, "contributor": null, "rationale": "clinic_id vem do usu\u00e1rio autenticado. email/cpf de usu\u00e1rio \u00fanicos globalmente; paciente \u00fanico por (clinic_id,cpf) e (clinic_id,prontu\u00e1rio). Email\u2192min\u00fasculas, trim em textos."}, {"id": "graphify_out_memory_docs_api_integration_error_envelope", "label": "Envelope de erro {error:{code,message,details}}", "file_type": "concept", "source_file": "graphify-out/memory/docs/api-integration.md", "source_location": "L282-L367", "source_url": null, "captured_at": "2026-09-23", "author": null, "contributor": null, "rationale": "Decidir o fluxo pelo STATUS HTTP (code pode ser gen\u00e9rico, ex. HTTP_ERROR em 409). Exibir error.message. 422 traz details[] com loc/msg/type do FastAPI (em error.details, n\u00e3o em detail)."}, {"id": "graphify_out_memory_docs_api_integration_status_codes", "label": "Status HTTP e a\u00e7\u00e3o do front", "file_type": "concept", "source_file": "graphify-out/memory/docs/api-integration.md", "source_location": "L284-L294", "source_url": null, "captured_at": "2026-09-23", "author": null, "contributor": null, "rationale": "401 \u2192 renovar (se houver refresh) ou encerrar sess\u00e3o; 403 \u2192 manter sess\u00e3o e mostrar acesso negado; 404 inclui inativo/outra cl\u00ednica; 409 duplicado; 422 destacar campos; 500 mensagem gen\u00e9rica."}, {"id": "graphify_out_memory_docs_api_integration_session_flow", "label": "Fluxo de renova\u00e7\u00e3o de sess\u00e3o", "file_type": "concept", "source_file": "graphify-out/memory/docs/api-integration.md", "source_location": "L369-L375", "source_url": null, "captured_at": "2026-09-23", "author": null, "contributor": null, "rationale": "Ap\u00f3s 401 tentar refresh s\u00f3 se houver refresh token; se falhar, descartar sess\u00e3o e ir ao login. Tratar falha de rede separada de erro HTTP."}, {"id": "graphify_out_memory_docs_api_integration_cors", "label": "CORS_ORIGINS (config da API)", "file_type": "concept", "source_file": "graphify-out/memory/docs/api-integration.md", "source_location": "L377-L392", "source_url": null, "captured_at": "2026-09-23", "author": null, "contributor": null, "rationale": "A origem exata do front (protocolo+porta, ex. http://localhost:3000) precisa estar em CORS_ORIGINS. N\u00e3o usar * com credenciais."}, {"id": "graphify_out_memory_docs_api_integration_future", "label": "Previsto Sprint 4, fora do contrato atual", "file_type": "concept", "source_file": "graphify-out/memory/docs/api-integration.md", "source_location": "L394-L404", "source_url": null, "captured_at": "2026-09-23", "author": null, "contributor": null, "rationale": "GET /users, dentista cadastrar/editar paciente, testes das novas permiss\u00f5es. Front n\u00e3o deve mostr\u00e1-los como dispon\u00edveis ainda."}], "edges": [{"source": "graphify_out_memory_docs_api_integration_doc", "target": "graphify_out_memory_docs_api_integration_base_url", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/memory/docs/api-integration.md", "source_location": null, "weight": 1.0}, {"source": "graphify_out_memory_docs_api_integration_doc", "target": "graphify_out_memory_docs_api_integration_health", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/memory/docs/api-integration.md", "source_location": null, "weight": 1.0}, {"source": "graphify_out_memory_docs_api_integration_doc", "target": "graphify_out_memory_docs_api_integration_login", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/memory/docs/api-integration.md", "source_location": null, "weight": 1.0}, {"source": "graphify_out_memory_docs_api_integration_doc", "target": "graphify_out_memory_docs_api_integration_refresh", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/memory/docs/api-integration.md", "source_location": null, "weight": 1.0}, {"source": "graphify_out_memory_docs_api_integration_doc", "target": "graphify_out_memory_docs_api_integration_me", "r